# All optional. Copy to backend\.env to change anything. Most settings (name, city, voice, model) are in the
# HUD's Settings instead.

# Port for the HUD and API. JARVIS only listens on this PC (127.0.0.1), never on your network.
JARVIS_PORT=8040

# Local language model through Ollama (free). Change the model in Settings, or here for the default.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Yolo Network Scanner, if you run it, so JARVIS can say who is on your Wi-Fi.
NETWORK_SCANNER_URL=http://127.0.0.1:8030

# DB_PATH=data/jarvis.db
