# All optional. Copy to backend\.env to change anything. Most settings (name, city, voice, model) are in the
# HUD's Settings instead.

# Port for the HUD and API.
JARVIS_PORT=8040

# Use JARVIS from your phone or another PC on the same Wi-Fi. Off by default, because JARVIS controls this PC.
# When on, other devices must open a secret access link once (Settings shows it on this PC; it's also printed
# at start-up). Voice input needs HTTPS on other devices, so they type; JARVIS still talks back.
# JARVIS_LAN=true

# Local language model through Ollama (free). Change the model in Settings, or here for the default.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional, much faster and smarter: Groq's free cloud tier (sign up at https://console.groq.com, no card,
# create an API key). Answers come back in about a second from a large model, and tap-to-talk speech is
# transcribed by Whisper large. Your questions and recordings then go to Groq. If Groq is down or you hit the
# free limit, JARVIS falls back to the local model automatically. Paste the key here only, never in a chat.
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
# GROQ_STT_MODEL=whisper-large-v3-turbo

# Yolo Network Scanner, if you run it, so JARVIS can say who is on your Wi-Fi.
NETWORK_SCANNER_URL=http://127.0.0.1:8030

# DB_PATH=data/jarvis.db
